#define GPIO_ENABLE_REG    0x3FF44020
#define GPIO_OUT_W1TS_REG  0x3FF44008
#define GPIO_OUT_W1TC_REG  0x3FF4400C

#define GPIO2 (1U << 2)

void app_main(void)
{
    // Configure GPIO 2 as output
    REG_WRITE(GPIO_ENABLE_REG,
              REG_READ(GPIO_ENABLE_REG) | GPIO2);

    // LED ON
    REG_WRITE(GPIO_OUT_W1TS_REG, GPIO2);

    // LED OFF
    REG_WRITE(GPIO_OUT_W1TC_REG, GPIO2);
}
